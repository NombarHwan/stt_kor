<?xml version="1.0" encoding="utf-8"?>
<!--
  Transcribe to Learn (TTL) - Microsoft Store(MSIX) 패키지 매니페스트

  PyInstaller onedir 산출물을 그대로 감싸는 전체 신뢰(full trust) Win32
  패키지다. UWP 앱이 아니므로 EntryPoint 는 Windows.FullTrustApplication 이고
  runFullTrust 기능이 필요하다.

  Identity 의 Name / Publisher / PublisherDisplayName 은 tools/make_msix.ps1 이
  빌드할 때 치환한다. 스토어 제출본은 Partner Center 발급값을, 로컬 사이드로드
  테스트본은 자체 서명 인증서 주체(CN=NombarHwan)를 쓴다 - 서명 인증서의 주체와
  매니페스트 Publisher 가 다르면 설치가 거부되기 때문이다.

  Partner Center > 제품 > 제품 ID (Store ID 9NBSRBP82NT8):
    Name      NombarHwan.TranscribetoLearn   <- 가운데 to 는 소문자다. 예약한
                                                이름에서 공백만 뺀 형태.
    Publisher CN=4A62FD04-10BA-49EF-89B6-10CAED11DC9E

  Version 은 네 자리이고 마지막 자리는 스토어가 0 을 요구한다.
  tools/make_msix.ps1 이 빌드할 때 {VERSION} 을 치환한다.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">

  <Identity
    Name="{IDENTITY_NAME}"
    Publisher="{PUBLISHER}"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Transcribe to Learn</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY}</PublisherDisplayName>
    <Description>강의 녹음을 컴퓨터 안에서 그대로 받아쓰는 프로그램입니다. 파일을 외부로 보내지 않습니다.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 = Windows 10 1809. 전체 신뢰 패키징이 안정적으로 되는 하한선. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>

  <Capabilities>
    <!-- Win32 실행 파일을 그대로 돌리기 위해 필요. 비게임 데스크톱 앱의 표준 구성이다. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="TTL" Executable="STT_KOR.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Transcribe to Learn"
        Description="강의 녹음을 컴퓨터 안에서 그대로 받아쓰는 프로그램입니다."
        BackgroundColor="#F3F3F3"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
